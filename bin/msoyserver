#!/bin/sh
#
# Command line launcher for the Msoy development server.

set -eu

MSOY_HOME=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

NODE=${MSOY_NODE:-msoy1}
HOSTNAME=${MSOY_HOSTNAME:-$(hostname)}
DEPOT_PG83=${DEPOT_PG83:-false}
SKIP_CHECK_REFERRER=${MSOY_SKIP_CHECK_REFERRER:-true}

JAVA_ARGS="-Djava.awt.headless=true \
           -Dskip_check_referrer=$SKIP_CHECK_REFERRER \
           -Dcom.samskivert.depot.verifyschema=true \
           -Dcom.samskivert.depot.pg83=$DEPOT_PG83 \
           -Dlog4j.configuration=log4j.properties \
           -Dorg.apache.commons.logging.Log=org.apache.commons.logging.impl.Log4JLogger \
           -Dehcache.disk.store.dir=world"

# Parse our arguments. Options are passed through to the Java launcher; a bare
# argument selects the Presents node name for compatibility with the old script.
while [ "$#" -gt 0 ]; do
    case "$1" in
        -*)
            JAVA_ARGS="$JAVA_ARGS $1"
            ;;
        *)
            NODE="$1"
            ;;
    esac
    shift
done

CLASS=com.threerings.msoy.server.MsoyServer
exec "$MSOY_HOME/bin/msoyjava" msoy -ea -server \
    -Dhostname="$HOSTNAME" -Dnode="$NODE" -Dis_node=true \
    $JAVA_ARGS "$CLASS"
