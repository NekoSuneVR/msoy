#!/bin/sh
#
# Sets up standard bits and runs java.

set -e

CYGWIN=
case "$(uname)" in
  CYGWIN*) CYGWIN=yes ;;
esac

MSOY_HOME=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
[ -z "$CYGWIN" ] || MSOY_HOME=$(cygpath -wam "$MSOY_HOME")

umask 002

JAVA_VM=$(command -v java || true)
if [ -z "$JAVA_VM" ] || [ ! -x "$JAVA_VM" ]; then
    echo "$0: Cannot find JVM. Exiting." >&2
    exit 255
fi

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 conf_prefix [arg ...]" >&2
    exit 255
fi

CONF_PREFIX=$1
shift
CONF_FILE="$MSOY_HOME/dist/${CONF_PREFIX}-server.conf"

# Obtain settings from MSOY_HOME/dist/${CONF_PREFIX}-server.conf.
if [ -r "$CONF_FILE" ]; then
    . "$CONF_FILE"
else
    echo "Unable to read $CONF_FILE." >&2
    echo "Usage: $0 conf_prefix [arg ...]" >&2
    exit 255
fi

RSRC_CACHE_DIR=${MSOY_RSRC_CACHE_DIR:-/tmp/msoy}
mkdir -p "$RSRC_CACHE_DIR"

JAVA_ARGS="-Dno_unpack_resources=true \
    -Dresource_dir=$MSOY_HOME/rsrc \
    -Drsrc_cache_dir=$RSRC_CACHE_DIR \
    -Djava.util.logging.config.file=$MSOY_HOME/etc/logging.properties"

if [ -n "${SMTP_HOST:-}" ]; then
    JAVA_ARGS="$JAVA_ARGS -Dmail.smtp.host=$SMTP_HOST"
fi

if [ -n "${SERVER_MEMORY:-}" ]; then
    JAVA_ARGS="$JAVA_ARGS -Xmx$SERVER_MEMORY"
fi

if [ -n "${MSOY_JAVA_OPTS:-}" ]; then
    JAVA_ARGS="$JAVA_ARGS $MSOY_JAVA_OPTS"
fi

ARGS=
# Extract -D arguments so they are guaranteed to appear before the classname.
while [ "$#" -gt 0 ]; do
    case "$1" in
        -D*)
            JAVA_ARGS="$JAVA_ARGS $1"
            ;;
        -debugger)
            JDWP_ARGS="transport=dt_socket,server=y,address=8000,suspend=n"
            JAVA_ARGS="-agentlib:jdwp=$JDWP_ARGS $JAVA_ARGS"
            ;;
        -jconsole)
            JAVA_ARGS="-Dcom.sun.management.jmxremote $JAVA_ARGS"
            ;;
        *)
            ARGS="$ARGS $1"
            ;;
    esac
    shift
done

{ [ -z "$CYGWIN" ] && SEP=:; } || SEP=';'

CLASSPATH=$MSOY_HOME/dist
for JAR in "$MSOY_HOME"/dist/lib/*.jar "$MSOY_HOME"/dist/msoy-*.jar; do
    if [ -e "$JAR" ]; then
        CLASSPATH="$CLASSPATH$SEP$JAR"
    fi
done
export CLASSPATH

# JAVA_ARGS and ARGS intentionally undergo shell word splitting because they are
# assembled from individual JVM arguments above and by the legacy launchers.
# shellcheck disable=SC2086
exec "$JAVA_VM" $JAVA_ARGS $ARGS
