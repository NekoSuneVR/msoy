# Runtime Docker configuration
MSOY_IMAGE_TAG=latest
MSOY_PUBLIC_URL=http://localhost:8080/
MSOY_SERVER_HOST=localhost
MSOY_HTTP_BIND_PORT=8080
MSOY_GAME_BIND_PORT=47624
MSOY_POLICY_BIND_PORT=47623
MSOY_DB_NAME=msoy
MSOY_DB_USER=msoy
MSOY_DB_PASSWORD=change-me
MSOY_JAVA_MEMORY=512M

# Important: the legacy GWT client also embeds MSOY_PUBLIC_URL and
# MSOY_SERVER_HOST at image build time. For a public/custom-domain deployment,
# build your own image with the matching Docker --build-arg values.
