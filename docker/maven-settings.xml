<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <!-- Some 2011-era Jetty/OOO POMs still declare an HTTP Sonatype repository.
         Maven now follows that endpoint to an HTML redirect page, which the old
         Maven Ant resolver then tries to parse as a POM. All artifacts we need
         from that repository are available from Maven Central over HTTPS. -->
    <mirror>
      <id>sonatype-snapshots-https</id>
      <mirrorOf>sonatype-snapshots</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>msoy-legacy-repositories</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>ooo-repo</id>
          <url>https://raw.githubusercontent.com/threerings/maven-repo/master/repository</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central-plugins</id>
          <url>https://repo.maven.apache.org/maven2</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>msoy-legacy-repositories</activeProfile>
  </activeProfiles>
</settings>
